{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horizon",
  "version": "0.2.0",
  "identifier": "local.claude.workspace",
  "build": {
    "devUrl": "http://127.0.0.1:5174/desktop/new",
    "frontendDist": "../dist-desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Horizon",
        "width": 1280,
        "height": 900,
        "minWidth": 850,
        "minHeight": 620,
        "url": "http://127.0.0.1:5174/desktop/new",
        "userAgent": "HorizonDesktop/0.1",
        "browserExtensionsEnabled": true,
        "dataDirectory": "trusted-interface"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
