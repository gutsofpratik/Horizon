{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaude",
  "version": "0.1.0",
  "identifier": "local.claude.workspace",
  "build": {
    "devUrl": "http://127.0.0.1:3001/desktop/new",
    "frontendDist": "../dist-desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenClaude",
        "width": 1280,
        "height": 900,
        "minWidth": 850,
        "minHeight": 620,
        "url": "http://127.0.0.1:3001/desktop/new",
        "userAgent": "OpenClaudeDesktop/0.1",
        "browserExtensionsEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
