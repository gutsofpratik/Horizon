@@ -8,6 +8,8 @@ use super::config::McpServerConfig;
 use super::manager::McpManager;
 use aion_protocol::events::ToolCategory;
 use aion_tools::Tool;
+use aion_tools::ToolExecutionOutput;
+use aion_types::message::{ContentBlock, ImageUrl};
 use aion_types::tool::{JsonSchema, ToolResult};
 
 /// Wraps an MCP server tool as a local Tool trait implementation.
@@ -85,6 +87,30 @@ impl Tool for McpToolProxy {
         }
     }
 
+    async fn execute_with_follow_up(&self, input: Value) -> ToolExecutionOutput {
+        let result = match self.manager.call_tool_result(&self.server_name, &self.tool_name, input).await {
+            Ok(result) => result,
+            Err(error) => return ToolResult { content: format!("MCP tool error: {error}"), is_error: true }.into(),
+        };
+        let mut text = Vec::new();
+        let mut follow_up_blocks = Vec::new();
+        for content in result.content {
+            match content {
+                super::protocol::McpContent::Text { text: part } => text.push(part),
+                super::protocol::McpContent::Image { data, mime_type } if !result.is_error => {
+                    let image_url = ImageUrl { url: format!("data:{mime_type};base64,{data}") };
+                    if let Err(error) = image_url.validate() {
+                        return ToolResult { content: format!("MCP returned an invalid image: {error}"), is_error: true }.into();
+                    }
+                    follow_up_blocks.push(ContentBlock::Image { image_url });
+                }
+                super::protocol::McpContent::Image { .. } => {},
+                super::protocol::McpContent::Resource { .. } => text.push("[resource]".to_owned()),
+            }
+        }
+        ToolExecutionOutput { result: ToolResult { content: text.join("\n"), is_error: result.is_error }, follow_up_blocks }
+    }
+
     fn category(&self) -> ToolCategory {
         ToolCategory::Mcp
     }
