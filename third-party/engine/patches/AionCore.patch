+// OpenClaude modification: authenticated private loopback bridge, including upgrades.
+async fn openclaude_host_auth(
+    axum::extract::State(token): axum::extract::State<Arc<String>>,
+    request: Request,
+    next: Next,
+) -> Response {
+    let supplied = request.headers().get("x-openclaude-engine-token").and_then(|v| v.to_str().ok()).unwrap_or("");
+    let valid = supplied.len() == token.len() && supplied.bytes().zip(token.bytes()).fold(0u8, |v, (a,b)| v | (a ^ b)) == 0;
