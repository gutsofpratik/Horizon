{
  "name": "horizon-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:runtime": "tsx --test tests/runtime/*.test.ts",
    "runtime:up": "tsx scripts/runtime-up.ts",
    "runtime:health": "tsx scripts/runtime-health.ts",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:prepare": "node scripts/desktop.mjs check",
    "desktop:package": "node scripts/desktop.mjs build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "export:web": "node scripts/export-web.mjs",
    "build:engine": "node scripts/build-component.mjs agent-backend",
    "build:web-host": "node scripts/build-component.mjs web-host",
    "build:inference": "node scripts/build-component.mjs inference",
    "build:ui": "node scripts/build-component.mjs shared-ui",
    "release:package": "node scripts/release/package.mjs",
    "inventory:ecosystem": "tsx scripts/generate-ecosystem-inventory.ts",
    "test:ecosystem": "tsx --test tests/provider-ecosystem.test.ts tests/providers.test.ts tests/ecosystem-foundation.test.ts tests/conversation-skills.test.ts tests/tool-circuit-breaker.test.ts tests/tool-recovery.test.ts tests/direct-model-interface.test.ts tests/engine-integration.test.ts tests/assistant-runtime.test.ts",
    "lint": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "package:native": "node scripts/package-native.mjs",
    "updates:sign": "node scripts/release/sign-update.mjs",
    "test:unit": "tsx --test tests/ecosystem-calendar.test.ts tests/compaction.test.ts tests/tool-circuit-breaker.test.ts",
    "test:contract": "tsx --test tests/ecosystem-foundation.test.ts tests/direct-model-interface.test.ts tests/capability-catalog.test.ts",
    "test:migration": "tsx --test tests/conversation-summary.test.ts tests/model-context-persistence.test.ts",
    "test:security": "tsx --test tests/action-approvals.test.ts tests/chat-tool-policy.test.ts tests/external-credentials.test.ts",
    "test:integration": "tsx --test tests/engine-integration.test.ts tests/provider-ecosystem.test.ts tests/assistant-runtime.test.ts",
    "desktop:icons": "tauri icon src-tauri/icons/source.svg --output src-tauri/icons",
    "test:release": "node --test tests/release-payload.test.mjs tests/release-signing.test.mjs",
    "export:source": "node scripts/release/export-source.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/credential-providers": "^3.1152.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tauri-apps/api": "^2.12.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.56.0",
    "mermaid": "^12.2.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tldts": "^7.4.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "description": "Local AI desktop workspace with native browser and terminal",
  "author": "Horizon contributors",
  "overrides": {
    "katex": "$katex"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gutsofpratik/OpenClaude.git"
  }
}
