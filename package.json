{
  "name": "openclaude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "runtime:up": "tsx scripts/runtime-up.ts",
    "runtime:health": "tsx scripts/runtime-health.ts",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:prepare": "node scripts/desktop.mjs check",
    "desktop:package": "node scripts/desktop.mjs build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "release:package": "node scripts/release/package.mjs",
    "export:source": "node scripts/release/export-source.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tauri-apps/api": "^2.12.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "fastify": "^5.12.7",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.56.0",
    "mermaid": "^12.2.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tldts": "^7.4.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "description": "Local AI desktop workspace with native browser and terminal",
  "author": "OpenClaude contributors",
  "overrides": {
    "katex": "$katex"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gutsofpratik/OpenClaude.git"
  }
}
